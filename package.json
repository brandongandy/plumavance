{
  "name": "pluma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run build --workspace @pluma/shared && npm run build --workspace @pluma/server && npm run build --workspace @pluma/web",
    "lint": "eslint .",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.64.0",
    "eslint": "9.39.1",
    "jsdom": "26.1.0",
    "typescript": "6.0.2",
    "typescript-eslint": "8.71.1"
  }
}
